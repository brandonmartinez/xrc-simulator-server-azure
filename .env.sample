# Azure Deployment Configuration for xRC Simulator Server
# Copy this file to .env and fill in your values

# Azure region to deploy to (e.g., eastus, westus2, centralus)
LOCATION=eastus

# Resource group name
RESOURCE_GROUP=xrc-simulator-rg

# VM Configuration
VM_NAME=xrc-simulator-vm
VM_SIZE=Standard_B2s
# For more reliable performance (non-burstable), use:
# VM_SIZE=Standard_D2as_v5

# Admin username for SSH access
ADMIN_USERNAME=azureuser

# Path to your SSH public key file
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# xRC Simulator Game Port (UDP)
GAME_UDP_PORT=11115

# Network Security - restrict SSH access (CIDR notation)
# Use your IP for security (e.g., 203.0.113.50/32) or 0.0.0.0/0 for any
SSH_SOURCE_CIDR=0.0.0.0/0

# Game traffic source (typically open to all players)
GAME_SOURCE_CIDR=0.0.0.0/0

# xRC Simulator Linux Server download URL
# Latest versions available at: https://xrcsimulator.org/downloads/
XRC_DOWNLOAD_URL=https://xrcsimulator.org/Downloads/xRC_Linux_Server_v19.2c.zip

# xRC Simulator Server credentials
# XRC_SERVER_USERNAME = admin name (used for admin chat commands, acts as a hidden login)
# XRC_SERVER_PASSWORD = server join password (players must enter this to connect)
XRC_SERVER_USERNAME=
XRC_SERVER_PASSWORD=

# xRC Simulator Game Number (0-22, see README for game list)
XRC_GAME=22

# Web Admin Configuration
# Port for the web admin interface (default: 8080)
WEB_ADMIN_PORT=8080
# Bind address (0.0.0.0 = public, 127.0.0.1 = localhost only / SSH tunnel)
WEB_ADMIN_BIND=0.0.0.0
